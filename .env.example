# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key

# PostgreSQL Database Connection URL
# Local development (no docker): postgresql://<username>:<password>@localhost:5432/<database_name>
# Docker compose deployment: postgresql://<username>:<password>@db:5432/<database_name>
DATABASE_URL=postgresql://campuseats:devpassword@localhost:5432/campuseats

# Server Port
PORT=5000
