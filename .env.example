# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key

# PostgreSQL Database Connection URL
# The "+psycopg2" is required: the pinned SQLAlchemy 2.1 defaults to a different driver (psycopg 3) without it.
# Local development (no docker): postgresql+psycopg2://<username>:<password>@localhost:5432/<database_name>
# Docker compose deployment: postgresql+psycopg2://<username>:<password>@db:5432/<database_name>
DATABASE_URL=postgresql+psycopg2://campuseats:devpassword@localhost:5432/campuseats

# Separate PostgreSQL database for automated tests
TEST_DATABASE_URL=postgresql+psycopg2://campuseats:devpassword@localhost:5432/campuseats_test

# Server Port
PORT=5000